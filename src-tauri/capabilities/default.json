{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for ja-netfilter-desktop main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:event:default",
    "core:app:default",
    "core:path:default",
    "dialog:default",
    "fs:default",
    "shell:default",
    "shell:allow-open",
    "os:default",
    "process:default"
  ]
}

