# pnpm configuration for ja-netfilter-desktop
# Treat the workspace as a single-package project (no hoist boundaries needed).

# Strict peer-dep resolution but allow auto-install of missing peers.
strict-peer-dependencies=false
auto-install-peers=true

# Don't run lifecycle scripts of transitive deps by default (security).
enable-pre-post-scripts=true

# Save exact versions when adding new deps.
save-exact=false

# Use the same store across CI and local dev.
store-dir=~/.local/share/pnpm/store
